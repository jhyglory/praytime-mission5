{
  "name": "praytime-mission5",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "preview:gap-light": "next dev --webpack --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prayers:seed": "node --env-file-if-exists=.env.cms.local --experimental-strip-types scripts/prayers/seed.mjs",
    "prayers:seed:dry-run": "node --env-file-if-exists=.env.cms.local --experimental-strip-types scripts/prayers/seed.mjs --dry-run",
    "dev:cms": "node scripts/prayers/dev.mjs",
    "prayers:cleanup": "node --env-file-if-exists=.env.cms.local --experimental-strip-types scripts/prayers/cleanup-image.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/supabase-js": "2.119.0",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.4",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
